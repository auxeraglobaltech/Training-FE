database -open waves -into waves.shm -default
probe -create -shm apb_master_tb.dut.PADDR apb_master_tb.dut.PCLK apb_master_tb.dut.PENABLE apb_master_tb.dut.PRDATA apb_master_tb.dut.PREADY apb_master_tb.dut.PRESETn apb_master_tb.dut.PSEL apb_master_tb.dut.PSLVERR apb_master_tb.dut.PWDATA apb_master_tb.dut.PWRITE apb_master_tb.dut.addr_reg apb_master_tb.dut.data_reg apb_master_tb.dut.error_reg apb_master_tb.dut.next_state apb_master_tb.dut.read_reg apb_master_tb.dut.state apb_master_tb.dut.transfer apb_master_tb.dut.transfer_count apb_master_tb.dut.write_reg
run
exit
